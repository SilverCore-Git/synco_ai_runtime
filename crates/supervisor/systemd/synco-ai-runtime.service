# Unité systemd (SYSTÈME) du Synco AI Runtime, sans conteneur : voir docs/deploiement.md §systemd.
# À copier dans /etc/systemd/system/, à adapter (chemin du binaire, utilisateur). Pas de doublon ailleurs :
# c'est l'unité de référence (L05, durcissement ; L06, bac à sable ; L09, installation).
#
# Clé du runtime scellée par systemd-creds (config.toml : [key_sealing] mode = "systemd-creds") :
#   1. créer l'utilisateur : useradd --system --no-create-home --shell /usr/sbin/nologin synco-ai-runtime
#   2. première fois, EN ROOT (le scellement sur la clé de l'hôte / le TPM2 exige root ; l'utilisateur
#      du service ne peut pas appeler systemd-creds encrypt) :
#        synco-ai-runtime --config /etc/synco-ai-runtime/config.toml pair
#      crée /var/lib/synco-ai-runtime/keys.cred (TPM2 et/ou clé de l'hôte) et affiche empreinte et code ;
#   3. systemctl enable --now synco-ai-runtime.service
# LoadCredentialEncrypted= remet l'identifiant déchiffré dans un ramfs propre au service
# ($CREDENTIALS_DIRECTORY), jamais sur disque ; le runtime l'y lit.

[Unit]
Description=Synco AI Runtime (superviseur)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=synco-ai-runtime
Group=synco-ai-runtime
ExecStart=/usr/local/bin/synco-ai-runtime --config /etc/synco-ai-runtime/config.toml run
Restart=on-failure
RestartSec=5s
# Délai d'arrêt > limits.shutdown_grace_secs (30 s par défaut).
TimeoutStopSec=45s

StateDirectory=synco-ai-runtime
StateDirectoryMode=0700
LoadCredentialEncrypted=synco-ai-runtime-keys:/var/lib/synco-ai-runtime/keys.cred
# Clés des fournisseurs LLM (décision D1), lues par api_key_file :
# LoadCredentialEncrypted=openai:/etc/synco-ai-runtime/openai.cred

# Mesure 8 : aucun fichier core, pas d'espace d'échange pour ce service (les clés ne peuvent pas
# être verrouillées en mémoire sans code non sûr ; voir README).
LimitCORE=0
MemorySwapMax=0

# Bac à sable des workers (lot L06, docs/plan/10-bac-a-sable.md). Validé avec `sandbox-check` dans
# une unité utilisateur portant ces mêmes options (une unité système n'a pas pu être essayée).
# - Delegate=yes : le service reçoit son sous-arbre cgroup ; le superviseur se place dans
#   <cgroup>/supervisor et crée <cgroup>/w-<n> par worker (memory.max, pids.max, cpu.max).
# - ProtectControlGroups=private (systemd ≥ 257) : espace de noms cgroup propre, sous-arbre délégué
#   en écriture. =yes (lecture seule) fait REFUSER le démarrage (cgroup_not_delegated) ; avec un
#   systemd plus ancien, retirer la ligne.
# - RestrictNamespaces= : seulement les espaces de noms que crée le bac à sable.
# - SystemCallFilter= : @system-service (dont unshare), @mount (montages et pivot_root du worker),
#   @sandbox (seccomp, landlock), sethostname. Le filtre propre du worker est bien plus strict.
# - ProtectHostname=yes interdit sethostname : le worker garde le nom de la machine (sans effet).
Delegate=yes
ProtectControlGroups=private
RestrictNamespaces=user pid net mnt ipc uts cgroup
SystemCallFilter=@system-service @mount @sandbox sethostname
SystemCallArchitectures=native
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
